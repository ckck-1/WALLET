# Supabase — get these from your project Settings > Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Server
PORT=3000
NODE_ENV=development

# Mobile Money webhook HMAC secret — provided by your MoMo API provider
MOMO_WEBHOOK_SECRET=your_hmac_secret_here

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.onrender.com
